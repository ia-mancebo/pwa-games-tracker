{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src/**/*.js", "tests/**/*.js", "scripts/**/*.js", "vite.config.js", "vitest.config.js"]
}
