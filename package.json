{
  "name": "game-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA 100% estática para gestionar tu biblioteca personal de videojuegos. Offline-first, un solo archivo .json como fuente de verdad.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:layout": "node scripts/check-layout.mjs",
    "test:layout:mobile": "node scripts/check-layout-mobile.mjs",
    "test:overflow:mobile": "node scripts/check-overflow-mobile.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
